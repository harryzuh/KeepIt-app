// KeepIT — modelo de dados (gera as tabelas do Diagrama ER no PostgreSQL)
// Fonte: Diagrama de Classes v3 e Diagrama ER da documentação.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NomePlano {
  INDIVIDUAL
  FAMILIA
  BUSINESS
}

enum Papel {
  ADMIN
  EDITOR
  LEITOR
}

enum StatusAssinatura {
  PENDENTE
  ATIVA
  CANCELADA
  EXPIRADA
}

/// ADR 0002 (D3): por que uma assinatura virou EXPIRADA.
enum MotivoEncerramento {
  CANCELAMENTO
  RECUSA
  TROCA
  TITULAR_EXCLUIDO
}

/// ADR 0002 (D4): marca do cartão simulado (nunca guardamos o número completo).
enum MarcaCartao {
  VISA
  MASTERCARD
  AMEX
  ELO
  OUTRA
}

/// ADR 0003 (D2): tipo REAL da imagem, conferido pelos primeiros bytes (não pela extensão).
enum TipoImagem {
  JPEG
  PNG
}

enum FinalidadeCodigo {
  RECUPERAR_SENHA
  ALTERAR_EMAIL
}

model Usuario {
  id                   Int       @id @default(autoincrement())
  nome                 String    @db.VarChar(80)
  email                String    @unique @db.VarChar(120)
  senhaHash            String    @map("senha_hash")
  criadoEm             DateTime  @default(now()) @map("criado_em") @db.Timestamptz
  exclusaoSolicitadaEm DateTime? @map("exclusao_solicitada_em") @db.Timestamptz
  /// ADR 0001 (A1): tokens JWT emitidos antes deste instante deixam de valer (logout, troca/redefinição de senha, exclusão).
  sessoesValidasDesde  DateTime  @default(now()) @map("sessoes_validas_desde") @db.Timestamptz

  membro              Membro?
  assinaturas         Assinatura[]        @relation("Titular")
  metodoPagamento     MetodoPagamento?
  produtosAdicionados Produto[]           @relation("AdicionadoPor")
  codigos             CodigoVerificacao[]
  logs                LogAuditoria[]

  @@map("usuario")
}

model Casa {
  id       Int      @id @default(autoincrement())
  nome     String   @db.VarChar(80)
  criadaEm DateTime @default(now()) @map("criada_em") @db.Timestamptz

  membros     Membro[]
  produtos    Produto[]
  tags        Tag[]
  assinaturas Assinatura[]
  logs        LogAuditoria[]

  @@map("casa")
}

/// Cada usuário participa de exatamente uma Casa por vez (usuario_id é único).
model Membro {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @unique @map("usuario_id")
  casaId    Int      @map("casa_id")
  papel     Papel
  entrouEm  DateTime @default(now()) @map("entrou_em") @db.Timestamptz

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  casa    Casa    @relation(fields: [casaId], references: [id], onDelete: Cascade)

  @@index([casaId])
  @@map("membro")
}

model Plano {
  id                    Int       @id @default(autoincrement())
  nome                  NomePlano @unique
  preco                 Decimal   @db.Decimal(10, 2)
  limiteMembros         Int       @map("limite_membros")
  limiteArmazenamentoGb Int       @map("limite_armazenamento_gb")

  assinaturas Assinatura[]

  @@map("plano")
}

/// Regra extra criada por migration SQL: no máximo uma assinatura ATIVA ou CANCELADA vigente por Casa
/// (índice único parcial em casa_id WHERE status IN ('ATIVA','CANCELADA')).
model Assinatura {
  id                 Int                 @id @default(autoincrement())
  casaId             Int                 @map("casa_id")
  planoId            Int                 @map("plano_id")
  /// ADR 0002 (D3): opcional; vira nulo quando o titular é apagado (a assinatura já está EXPIRADA).
  titularId          Int?                @map("titular_id")
  status             StatusAssinatura    @default(PENDENTE)
  dataInicio         DateTime            @default(now()) @map("data_inicio") @db.Timestamptz
  dataRenovacao      DateTime            @map("data_renovacao") @db.Timestamptz
  dataCancelamento   DateTime?           @map("data_cancelamento") @db.Timestamptz
  refPagamento       String?             @map("ref_pagamento")
  /// ADR 0002 (D3): preenchidos quando a assinatura vira EXPIRADA.
  motivoEncerramento MotivoEncerramento? @map("motivo_encerramento")
  encerradaEm        DateTime?           @map("encerrada_em") @db.Timestamptz

  casa    Casa     @relation(fields: [casaId], references: [id], onDelete: Cascade)
  plano   Plano    @relation(fields: [planoId], references: [id])
  titular Usuario? @relation("Titular", fields: [titularId], references: [id], onDelete: SetNull)

  @@index([casaId, status])
  @@index([status, dataRenovacao])
  @@map("assinatura")
}

/// ADR 0002 (D4): método de pagamento SIMULADO do usuário (um por usuário). Só marca e 4 últimos dígitos (RNF04).
model MetodoPagamento {
  id           Int         @id @default(autoincrement())
  usuarioId    Int         @unique @map("usuario_id")
  marca        MarcaCartao
  ultimos4     String      @db.Char(4)
  atualizadoEm DateTime    @default(now()) @map("atualizado_em") @db.Timestamptz

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("metodo_pagamento")
}

model Produto {
  id              Int      @id @default(autoincrement())
  casaId          Int      @map("casa_id")
  adicionadoPorId Int?     @map("adicionado_por_id")
  nome            String   @db.VarChar(120)
  descricao       String?
  preco           Decimal  @db.Decimal(12, 2)
  quantidade      Int      @default(1)
  dataCompra      DateTime @map("data_compra") @db.Date
  dataCadastro    DateTime @default(now()) @map("data_cadastro") @db.Timestamptz
  /// ADR 0003 (D1): última alteração (tela 07). A migration cria a coluna com default now(); o Prisma a atualiza em todo update.
  atualizadoEm    DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz

  casa          Casa         @relation(fields: [casaId], references: [id], onDelete: Cascade)
  adicionadoPor Usuario?     @relation("AdicionadoPor", fields: [adicionadoPorId], references: [id], onDelete: SetNull)
  fotos         Foto[]
  tags          ProdutoTag[]

  /// A busca e a verificação de duplicado usam lower(nome); o índice funcional é criado por migration SQL.
  @@index([casaId, nome])
  @@map("produto")
}

/// Até 3 fotos por produto (validado na API). ADR 0003 (D2, D5): guarda a CHAVE do objeto no S3, nunca uma URL;
/// a URL de leitura é assinada a cada resposta. Só foto gravada aqui conta na cota de armazenamento (RF39).
model Foto {
  id           Int        @id @default(autoincrement())
  produtoId    Int        @map("produto_id")
  /// Chave do objeto no bucket: casas/<casaId>/fotos/<uuid>.<jpg|png> (gerada pelo servidor).
  chave        String     @unique
  tipo         TipoImagem
  tamanhoBytes Int        @map("tamanho_bytes")
  ordem        Int        @db.SmallInt
  criadaEm     DateTime   @default(now()) @map("criada_em") @db.Timestamptz

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([produtoId])
  @@map("foto")
}

model Tag {
  id     Int    @id @default(autoincrement())
  casaId Int    @map("casa_id")
  nome   String @db.VarChar(40)

  casa     Casa         @relation(fields: [casaId], references: [id], onDelete: Cascade)
  produtos ProdutoTag[]

  /// Unicidade por Casa SEM diferenciar caixa: índice único funcional (casa_id, lower(nome)) criado por migration SQL (ADR 0003 D1).
  @@unique([casaId, nome])
  @@map("tag")
}

model ProdutoTag {
  produtoId Int @map("produto_id")
  tagId     Int @map("tag_id")

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([produtoId, tagId])
  @@map("produto_tag")
}

model CodigoVerificacao {
  id         Int              @id @default(autoincrement())
  usuarioId  Int              @map("usuario_id")
  codigoHash String           @map("codigo_hash")
  finalidade FinalidadeCodigo
  /// ADR 0001 (A2): e-mail pendente de confirmação (somente finalidade ALTERAR_EMAIL).
  novoEmail  String?          @map("novo_email") @db.VarChar(120)
  /// Erros de digitação do código; ao chegar no limite o código é invalidado (AppSec F2).
  tentativas Int              @default(0)
  expiraEm   DateTime         @map("expira_em") @db.Timestamptz
  usadoEm    DateTime?        @map("usado_em") @db.Timestamptz

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("codigo_verificacao")
}

/// RNF05: registro de alterações de plano, assinatura, cancelamento e exclusão de produtos.
model LogAuditoria {
  id         BigInt   @id @default(autoincrement())
  usuarioId  Int?     @map("usuario_id")
  casaId     Int?     @map("casa_id")
  acao       String
  entidade   String
  entidadeId Int      @map("entidade_id")
  detalhes   Json?
  criadoEm   DateTime @default(now()) @map("criado_em") @db.Timestamptz

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  casa    Casa?    @relation(fields: [casaId], references: [id], onDelete: SetNull)

  @@index([casaId, criadoEm])
  /// ADR 0003 (D1): histórico de um produto (tela 07).
  @@index([entidade, entidadeId, criadoEm])
  @@map("log_auditoria")
}
