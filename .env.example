# Copie para .env — nunca faça commit do .env
NODE_ENV=development
PORT=3333
CORS_ORIGIN=http://localhost:5173

# Sobrescrito pelo docker-compose em dev; em prod aponta para o Neon
DATABASE_URL=postgresql://keepit:keepit@localhost:5432/keepit?schema=public

JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=8h
JOBS_TOKEN=troque-por-outro-segredo-longo-e-aleatorio
# Segredos: mínimo 32 caracteres; em produção o valor "troque..." é recusado na inicialização.
# CODIGO_SECRET: chave própria do HMAC dos códigos (obrigatória em produção, diferente do JWT_SECRET;
# em dev/teste, se ausente, é derivada do JWT_SECRET).
CODIGO_SECRET=troque-por-um-terceiro-segredo-longo-e-aleatorio
# Desliga os limites de requisição (somente dev/E2E; recusado em produção).
# RATE_LIMIT_DESLIGADO: o docker-compose liga (true) em dev; nunca em produção
# CORS_ORIGIN aceita várias origens separadas por vírgula (ex.: http://localhost:5173,http://frontend:5173)

# S3 (SeaweedFS em dev, Cloudflare R2 em prod)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
# Endpoint usado só para ASSINAR as URLs entregues ao navegador (opcional). Em dev, deixe vazio: o front
# reescreve a origem para /s3 (proxy do Vite). Em produção (R2) use o domínio público do bucket, se houver.
# S3_PUBLIC_ENDPOINT=
S3_UPLOAD_URL_TTL_S=300
S3_READ_URL_TTL_S=3600
S3_BUCKET=keepit-fotos
S3_ACCESS_KEY_ID=keepit
S3_SECRET_ACCESS_KEY=keepit-secret

# E-mail (Mailpit em dev via SMTP, Resend em prod)
MAIL_FROM=KeepIT <no-reply@keepit.local>
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=

# Pagamento (M5). true = gateway simulado (cartões de teste 4242 4242 4242 4242 e 4111 1100 0005 0000).
# Em produção use false: o backend RECUSA iniciar com NODE_ENV=production e PAGAMENTO_SIMULADO=true.
# Com false e sem gateway real, contratar plano responde 503 PAGAMENTO_INDISPONIVEL e GET /planos devolve
# contratacaoDisponivel=false: a tela de planos aparece com os botões desativados (planos pagos desativados no MVP).
PAGAMENTO_SIMULADO=true

